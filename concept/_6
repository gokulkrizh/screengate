func suspendDiet(duration: BreakDuration) {
    // Stop all monitoring
    center.stopMonitoring([allSchedules])
    
    // Set auto-resume
    let resumeDate = Date().addingTimeInterval(duration.timeInterval)
    scheduleAutoResume(at: resumeDate)
    
    // Log break for report
    logDietBreak(start: Date(), duration: duration, reason: userReason)
}

func activateWeekendMode() {
    // Replace strict schedules with relaxed versions
    let relaxedCarb = DeviceActivitySchedule(
        intervalStart: DateComponents(hour: 10),
        intervalEnd: DateComponents(hour: 20),
        repeats: true
    )
    
    center.stopMonitoring([strictSchedules])
    center.startMonitoring([relaxedEvents], during: relaxedCarb)
}
```

